# ============================================
# SPEEDA CONFIGURATION
# ============================================
# After setup, run: php artisan storage:link
# This is CRITICAL for images to work!
# ============================================

APP_NAME=Speeda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Analytics privacy salt — generate with: php artisan key:generate --show
ANALYTICS_SALT=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug locally. On the server use `warning`, not `error`: the app logs
# recoverable-but-worth-knowing events (a rejected upload, a failed
# broadcast send, a Google sign-in that could not complete) at warning
# level, and `error` throws all of them away — which is exactly the
# detail you need when someone reports that something stopped working.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=speeda
DB_USERNAME=root
DB_PASSWORD=

# Proxies whose X-Forwarded-For / X-Forwarded-Proto are believed (config/trustedproxy.php).
# Loopback covers CloudPanel's internal nginx hop. Behind Cloudflare, add its ranges.
# TRUSTED_PROXIES=127.0.0.1,::1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_URL starts with https:// (required by deploy:verify).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# File Storage Configuration
# After cloning, run: php artisan storage:link
# Options: local (default), s3, public
# Note: Uploaded images are NOT in Git (see docs/README.md)
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_USERNAME="support@speeda.ca"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@speeda.ca"
MAIL_FROM_NAME="Speeda Support"
# Seconds per SMTP read/write; keep below the queue job timeout (60s) so a slow
# server fails a send cleanly instead of the worker killing it mid-delivery.
# MAIL_TIMEOUT=20
SUPPORT_EMAIL="support@speeda.ca"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Sign-In (see docs/OPERATIONS.md; verify with: php artisan speeda:google-check)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
