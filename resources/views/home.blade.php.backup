        }

        .benefit-card .btn:hover::before {
            left: 100%;
        }

        .benefit-card .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        }

        .benefit-card .btn:active {
